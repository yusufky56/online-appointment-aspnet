@{
    ViewData["Title"] = "Ana Sayfa";
}

<div class="text-center">
    <h1 class="display-4">Online Randevu Sistemine Hoş Geldiniz</h1>
    <p>Berber ve kuaför randevularınızı kolayca yönetin.</p>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <a class="btn btn-primary" asp-controller="Appointment" asp-action="Create">Randevu Oluştur</a>
    }
    else
    {
        <a class="btn btn-primary" asp-area="Identity" asp-page="/Account/Register">Kayıt Ol</a>
        <a class="btn btn-secondary" asp-area="Identity" asp-page="/Account/Login">Giriş Yap</a>
    }
</div>

<div id="calendar" class="mt-4"></div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var calendarEl = document.getElementById('calendar');
            var calendar = new FullCalendar.Calendar(calendarEl, {
                initialView: 'dayGridMonth',
                locale: 'tr',
                events: '/api/appointments' // API ile randevuları çekecek (isteğe bağlı)
            });
            calendar.render();
        });
    </script>
}